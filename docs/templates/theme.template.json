{
  // ============================================================================
  //  LINTEL THEME TEMPLATE
  //
  //  A theme is just colours + a few toggles. Copy this file into:
  //      %AppData%\Lintel\themes\
  //  (or use Settings → Customization → "Import theme…", or the bar's theme menu
  //   → "Import theme…"). It then shows up in the theme picker by its "name".
  //
  //  Colours are "#AARRGGBB"  (AA = alpha/opacity, then red, green, blue).
  //  e.g. "#FF0A84FF" = opaque blue, "#14FFFFFF" = ~8% white.
  //  Comments (//) and trailing commas are allowed in these files.
  // ============================================================================

  "name": "Sunset",            // shown in the theme picker — make it unique

  "bubbleIdle":  "#14FF8A65",  // each widget's background, normally
  "bubbleHover": "#33FF8A65",  // each widget's background, when hovered

  "cornerRadius": 11,          // widget roundness (0 = square, ~16 = pill)
  "padding": 9,                // horizontal padding inside each widget
  "spacing": 5,                // gap between widgets

  "iconSaturation": 1.0,       // 1 = full-colour icons, 0 = grayscale

  "acrylic": true,             // translucent bar (the tint's AA controls how see-through it is)
  "acrylicTint": "#B0241814",  // tint colour — LOWER the AA for clearer glass
  "aeroBlur": false,           // (legacy OS blur; ignored on Win11 where it doesn't work)
  "frostedGlass": true,        // REAL real-time blur of the live content behind the bar (see "Live glass blur" in settings)

  "bottomHighlight": true,     // thin light hairline along the bar's bottom edge
  "widgetDividers": false,     // draw a subtle divider between every widget

  "separatedZones": false,     // true = left/center/right become floating pills
  "zoneBackground": "#E61C1C1E", // the pill colour when separatedZones is true

  // ---- distinctive cosmetics (all optional) ----
  // Make a theme truly its own: change the bar's size, material, gloss and detailing.

  "barTop": "",                // bar gradient top colour (e.g. "#FF3E86F0" for an XP-style bar)
  "barBottom": "",             // bar gradient bottom colour ("" on both = no gradient)
  "dropdownColor": "",         // force the dropdown panel colour ("" = match the bar)

  "barHeight": 0,              // override the bar height in px (0 = use the global setting)
  "fontFamily": "",            // theme font, e.g. "Tahoma" or "Comic Sans MS" ("" = default)

  "glossStrength": 0,          // 0–1 glossy reflection across the top half (Aero / Luna shine)
  "topEdge": "",               // bright hairline along the top edge, e.g. "#88FFFFFF"
  "bottomEdge": "",            // hairline along the bottom edge

  "bubbleBorder": "",          // outline around each widget (raised-button look), e.g. "#80FFFFFF"
  "bubbleBorderThickness": 1,
  "bubbleGloss": 0             // 0–1 glossy sheen on each widget bubble
}
