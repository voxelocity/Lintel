<UserControl x:Class="Lintel.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="13"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8E8E93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,8"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF0A84FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,15,0,6"/>
        </Style>

        <!-- Themed text box -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF3A3A3E"/>
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- Pill button -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF3A3A3E"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented mode option -->
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD0D0D5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#F51F1F23" CornerRadius="16" Width="452">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20,16,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Lintel Settings" FontWeight="Bold" FontSize="17"/>
                    <TextBlock Text="macOS / Linux-style top bar" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                </StackPanel>
                <Border x:Name="CloseX" DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="13"
                        Background="#22FFFFFF" Cursor="Hand" VerticalAlignment="Top"
                        MouseLeftButtonDown="Close_Click">
                    <TextBlock Text="✕" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="600" Margin="0,8,0,0">
                <StackPanel>
                    <!-- Mode segmented control -->
                    <TextBlock Text="VISIBILITY MODE" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                    <Border Background="#FF2C2C30" CornerRadius="9" Padding="3">
                        <UniformGrid Rows="1" Columns="3">
                            <Button x:Name="ModeAlways"  Style="{StaticResource Seg}" Click="Mode_Click" Tag="0" Content="Always On"/>
                            <Button x:Name="ModeAuto"    Style="{StaticResource Seg}" Click="Mode_Click" Tag="1" Content="Auto-Hide"/>
                            <Button x:Name="ModeDynamic" Style="{StaticResource Seg}" Click="Mode_Click" Tag="2" Content="Dynamic"/>
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="2,6,0,0"/>

                    <!-- Auto-hide timing -->
                    <TextBlock Text="AUTO-HIDE TIMING" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Reveal hold (ms)" Margin="0,4"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RevealHoldBox" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="Hide delay (ms)" Margin="0,4"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="HideDelayBox" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="Trigger zone (px)" Margin="0,4"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TriggerZoneBox" Margin="0,4"/>
                    </Grid>

                    <!-- Dynamic timing -->
                    <TextBlock Text="DYNAMIC TIMING" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Hide delay (ms) — grace when covered"/>
                        <TextBox Grid.Column="1" x:Name="DynamicHideBox"/>
                    </Grid>

                    <!-- Appearance -->
                    <TextBlock Text="APPEARANCE" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Bar height (px)" Margin="0,4"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BarHeightBox" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Text="Background (#AARRGGBB)" Margin="0,4"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="BgColorBox" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Text="Text color (#AARRGGBB)" Margin="0,4"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="FgColorBox" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Text="Accent color (#AARRGGBB)" Margin="0,4"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="AccentColorBox" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Text="Animation (ms)" Margin="0,4"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="AnimationBox" Margin="0,4"/>
                    </Grid>

                    <!-- Items -->
                    <TextBlock Text="ITEMS" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="Clock24Chk" Content="Use 24-hour clock"/>
                    <TextBlock Text="Add, remove and reorder widgets via the bar's Customize mode (the + pill)."
                               Style="{StaticResource Hint}" Margin="0,6,0,0"/>

                    <!-- System -->
                    <TextBlock Text="SYSTEM" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Monitor index (0 = primary)"/>
                        <TextBox Grid.Column="1" x:Name="MonitorBox"/>
                    </Grid>
                    <CheckBox x:Name="StartupChk" Content="Launch Lintel at Windows startup" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Apply" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="Apply_Click"/>
                <Button Content="Save &amp; Close" Style="{StaticResource Pill}" Background="#FF0A84FF" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
