<UserControl x:Class="Lintel.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="13"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8E8E93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,8"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF0A84FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF3A3A3E"/>
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF3A3A3E"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="Foreground" Value="#FFD0D0D5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="#FF0A84FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Background + shadow are supplied by the host Card so the panel matches the theme. -->
    <Border x:Name="Root" Background="Transparent" CornerRadius="16" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid Margin="20,16,20,18">
            <!-- ===================== QUICK VIEW ===================== -->
            <StackPanel x:Name="QuickView">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Quick Settings" FontWeight="Bold" FontSize="17"/>
                    <Border DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="13" Background="#22FFFFFF"
                            Cursor="Hand" VerticalAlignment="Top" MouseLeftButtonDown="Close_Click">
                        <TextBlock Text="✕" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>

                <TextBlock Text="VISIBILITY MODE" Style="{StaticResource Section}" Margin="0,12,0,6"/>
                <Border Background="#FF2C2C30" CornerRadius="9" Padding="3">
                    <UniformGrid Rows="1" Columns="3">
                        <Button x:Name="QModeAlways"  Style="{StaticResource Seg}" Click="QMode_Click" Tag="0" Content="Always On"/>
                        <Button x:Name="QModeAuto"    Style="{StaticResource Seg}" Click="QMode_Click" Tag="1" Content="Auto-Hide"/>
                        <Button x:Name="QModeDynamic" Style="{StaticResource Seg}" Click="QMode_Click" Tag="2" Content="Dynamic"/>
                    </UniformGrid>
                </Border>

                <TextBlock Text="POSITION" Style="{StaticResource Section}"/>
                <Border Background="#FF2C2C30" CornerRadius="9" Padding="3">
                    <UniformGrid Rows="1" Columns="2">
                        <Button x:Name="PosTop"    Style="{StaticResource Seg}" Click="Pos_Click" Tag="0" Content="Top"/>
                        <Button x:Name="PosBottom" Style="{StaticResource Seg}" Click="Pos_Click" Tag="1" Content="Bottom"/>
                    </UniformGrid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Bar height (px)"/>
                    <TextBox Grid.Column="1" x:Name="QBarHeight"/>
                </Grid>

                <CheckBox x:Name="QHover" Content="Open dropdowns on hover" Margin="0,12,0,0"/>
                <CheckBox x:Name="QClock24" Content="Use 24-hour clock"/>
                <CheckBox x:Name="QStartup" Content="Launch at Windows startup"/>

                <Button Style="{StaticResource Link}" Click="ShowAdvanced_Click" Margin="0,8,0,0">
                    <TextBlock Text="Advanced settings ›" FontWeight="SemiBold"/>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Apply" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="Apply_Click"/>
                    <Button Content="Done" Style="{StaticResource Pill}" Background="#FF0A84FF" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- ===================== ADVANCED VIEW ===================== -->
            <DockPanel x:Name="AdvancedView" Visibility="Collapsed" LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Link}" Click="ShowQuick_Click">
                        <TextBlock Text="‹ Quick settings" FontWeight="SemiBold"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="Advanced Settings" FontWeight="Bold" FontSize="17" Margin="16,0,0,0"/>
                    <Border DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="13" Background="#22FFFFFF"
                            Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonDown="Close_Click">
                        <TextBlock Text="✕" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>

                <!-- pinned footer -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Tip: add, remove and reorder widgets with the bar's Customize pill (right-click → Customize Widgets)."
                               Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Apply" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="Apply_Click"/>
                        <Button Content="Done" Style="{StaticResource Pill}" Background="#FF0A84FF" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- scrollable content -->
                <ScrollViewer MaxHeight="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,8,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="VISIBILITY MODE" Style="{StaticResource Section}" Margin="0,6,0,6"/>
                        <Border Background="#FF2C2C30" CornerRadius="9" Padding="3">
                            <UniformGrid Rows="1" Columns="3">
                                <Button x:Name="ModeAlways"  Style="{StaticResource Seg}" Click="Mode_Click" Tag="0" Content="Always On"/>
                                <Button x:Name="ModeAuto"    Style="{StaticResource Seg}" Click="Mode_Click" Tag="1" Content="Auto-Hide"/>
                                <Button x:Name="ModeDynamic" Style="{StaticResource Seg}" Click="Mode_Click" Tag="2" Content="Dynamic"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="2,6,0,0"/>

                        <TextBlock Text="AUTO-HIDE TIMING" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Reveal hold (ms)" Margin="0,4"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RevealHoldBox" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Text="Hide delay (ms)" Margin="0,4"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="HideDelayBox" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Text="Trigger zone (px)" Margin="0,4"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TriggerZoneBox" Margin="0,4"/>
                        </Grid>

                        <TextBlock Text="DYNAMIC TIMING" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Hide delay (ms)"/>
                            <TextBox Grid.Column="1" x:Name="DynamicHideBox"/>
                        </Grid>
                    </StackPanel>

                    <!-- RIGHT COLUMN -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="APPEARANCE" Style="{StaticResource Section}" Margin="0,6,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Bar height (px)" Margin="0,4"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BarHeightBox" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Text="Background" Margin="0,4"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="BgColorBox" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Text="Text color" Margin="0,4"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="FgColorBox" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Text="Accent color" Margin="0,4"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="AccentColorBox" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Text="Animation (ms)" Margin="0,4"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="AnimationBox" Margin="0,4"/>
                        </Grid>

                        <TextBlock Text="ITEMS" Style="{StaticResource Section}"/>
                        <CheckBox x:Name="Clock24Chk" Content="Use 24-hour clock"/>

                        <TextBlock Text="SYSTEM" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor index (0 = primary)"/>
                            <TextBox Grid.Column="1" x:Name="MonitorBox"/>
                        </Grid>
                        <CheckBox x:Name="StartupChk" Content="Launch at Windows startup" Margin="0,6,0,0"/>

                        <TextBlock Text="THEME" Style="{StaticResource Section}"/>
                        <Border Background="#FF2C2C30" CornerRadius="9" Padding="3">
                            <UniformGrid Rows="1" Columns="4">
                                <Button x:Name="ThemeSquircles" Style="{StaticResource Seg}" Click="Theme_Click" Tag="0" Content="Squircles"/>
                                <Button x:Name="ThemePower"     Style="{StaticResource Seg}" Click="Theme_Click" Tag="1" Content="Power"/>
                                <Button x:Name="ThemeIslands"   Style="{StaticResource Seg}" Click="Theme_Click" Tag="2" Content="Islands"/>
                                <Button x:Name="ThemeMond"      Style="{StaticResource Seg}" Click="Theme_Click" Tag="3" Content="Mond"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="CLAUDE WIDGET" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Token budget per 5h (0 = show usage)"/>
                            <TextBox Grid.Column="1" x:Name="ClaudeLimitBox"/>
                        </Grid>

                        <TextBlock Text="CUSTOMIZATION" Style="{StaticResource Section}"/>
                        <CheckBox x:Name="CmdWidgetsChk" Content="Allow command widgets to run their commands" Margin="0,2,0,4"/>
                        <CheckBox x:Name="LiveBlurChk" Content="Live glass blur (frosted themes; hides the bar from screen capture)" Margin="0,2,0,4"/>
                        <CheckBox x:Name="LiteChk" Content="Lite mode (skip the dropdown blur — half-opacity instead; bar blur &amp; animations kept)" Margin="0,2,0,4"/>
                        <CheckBox x:Name="PotatoChk" Content="Potato mode (low-end PCs: no blur, reduced animations)" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Import theme…"  Style="{StaticResource Pill}" Margin="0,0,8,0" Click="ImportTheme_Click"/>
                            <Button Content="Import widget…" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="ImportWidget_Click"/>
                            <Button Content="Open folder"    Style="{StaticResource Pill}" Click="OpenFolderBtn_Click"/>
                        </StackPanel>
                        <TextBlock Text="Drop .json themes/widgets in the folder or import them here. Templates: github.com/voxelocity/Lintel/tree/main/docs/templates"
                                   Style="{StaticResource Hint}" Margin="0,8,0,0"/>

                        <TextBlock Text="WIDGETS" Style="{StaticResource Section}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Weather location (blank = auto)"/>
                            <TextBox Grid.Column="1" x:Name="WeatherLocBox"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Stock/crypto symbols"/>
                            <TextBox Grid.Column="1" x:Name="StockSymBox"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
