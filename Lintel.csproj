<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Lintel</AssemblyName>
    <RootNamespace>Lintel</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Lintel</Authors>
    <Product>Lintel</Product>
    <!-- WPF reads DPI awareness from app.manifest; the WinForms toolchain warns about it regardless. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Single trimmed self-contained exe is produced via the publish profile, not here -->
  </PropertyGroup>

  <!-- UseWindowsForms auto-imports System.Drawing / System.Windows.Forms globally, which
       collides with WPF's Color/Brush. Drop those implicit usings; the one file that needs
       them (App.xaml.cs, for the tray icon) imports them explicitly. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
