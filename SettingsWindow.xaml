<Window x:Class="Lintel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lintel Settings"
        Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF1C1C1E"
        Foreground="#FFF2F2F7"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8E8E93"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,1,0,8"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF0A84FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2C2C2E"/>
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3C"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="LINTEL" FontWeight="Bold" FontSize="16" Foreground="#FFF2F2F7"/>
        <TextBlock Text="macOS / Linux-style top bar for Windows 11" Style="{StaticResource Hint}"/>

        <!-- Visibility mode -->
        <TextBlock Text="VISIBILITY MODE" Style="{StaticResource Section}"/>
        <ComboBox x:Name="ModeBox" SelectedIndex="2">
            <ComboBoxItem Content="Always On  —  always visible, reserves space"/>
            <ComboBoxItem Content="Auto-Hide  —  reveal by moving cursor to the top"/>
            <ComboBoxItem Content="Dynamic  —  hides under fullscreen / overlapping apps"/>
        </ComboBox>

        <!-- Auto-hide timing -->
        <TextBlock Text="AUTO-HIDE TIMING" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Reveal hold (ms) — rest at top before showing" Margin="0,3"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RevealHoldBox" Margin="0,3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hide delay (ms) — keep open after cursor leaves" Margin="0,3"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="HideDelayBox" Margin="0,3"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Trigger zone (px) — top hot-edge thickness" Margin="0,3"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TriggerZoneBox" Margin="0,3"/>
        </Grid>

        <!-- Dynamic timing -->
        <TextBlock Text="DYNAMIC TIMING" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hide delay (ms) — grace before hiding when covered"/>
            <TextBox Grid.Column="1" x:Name="DynamicHideBox"/>
        </Grid>

        <!-- Appearance -->
        <TextBlock Text="APPEARANCE" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bar height (px)" Margin="0,3"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BarHeightBox" Margin="0,3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Background color (#AARRGGBB)" Margin="0,3"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="BgColorBox" Margin="0,3"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Text color (#AARRGGBB)" Margin="0,3"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="FgColorBox" Margin="0,3"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Accent color (#AARRGGBB)" Margin="0,3"/>
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="AccentColorBox" Margin="0,3"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Animation (ms) — slide in/out" Margin="0,3"/>
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="AnimationBox" Margin="0,3"/>
        </Grid>

        <!-- Toggles -->
        <TextBlock Text="ITEMS" Style="{StaticResource Section}"/>
        <CheckBox x:Name="Clock24Chk" Content="Use 24-hour clock"/>
        <TextBlock Text="Add, remove and reorder widgets (CPU, GPU, clock, …) by right-clicking the bar and choosing &quot;Customize Widgets&quot;, then using the + button and drag."
                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>

        <TextBlock Text="SYSTEM" Style="{StaticResource Section}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Monitor index (0 = primary)"/>
            <TextBox Grid.Column="1" x:Name="MonitorBox"/>
        </Grid>
        <CheckBox x:Name="StartupChk" Content="Launch Lintel at Windows startup" Margin="0,8,0,0"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ApplyBtn" Content="Apply" Width="80" Height="30" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button x:Name="SaveBtn" Content="Save &amp; Close" Width="110" Height="30" Margin="0,0,8,0" Click="Save_Click"/>
            <Button x:Name="CancelBtn" Content="Close" Width="80" Height="30" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
